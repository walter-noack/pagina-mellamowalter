Options -MultiViews
RewriteEngine On
RewriteBase /

# Servir archivos y directorios reales directamente (PDFs, imágenes, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás al SPA
RewriteRule ^ index.html [L]

# index.html: nunca cachear (siempre la versión más reciente)
<Files "index.html">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# Assets con hash en el nombre: caché larga (1 año)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
